# Caddy: unico ingresso da Internet. HTTPS automatico (Let's Encrypt) quando SITE_ADDRESS è un dominio.
# In locale SITE_ADDRESS=http://localhost (niente certificati).
{$SITE_ADDRESS} {
	encode zstd gzip

	# Il form pesa pochi KB: richieste più grandi vengono rifiutate qui, prima di arrivare a Java
	request_body {
		max_size 64KB
	}

	# API interne e actuator non sono mai raggiungibili da fuori
	@internal path /api/* /actuator /actuator/*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Script solo dal sito e da Cloudflare Turnstile (anti-bot del form); nessuno script inline
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}

	# Caddy SOSTITUISCE X-Forwarded-For con l'IP reale del client (non si fida di quello in arrivo):
	# web-public lo legge solo perché arriva da qui, un proxy della rete interna.
	reverse_proxy web-public:8080
}
