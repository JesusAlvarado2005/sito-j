# Copia questo file in ".env" e cambia le password (.env NON va mai committato).
#   cp .env.example .env

# --- PostgreSQL (superuser, usato solo per l'inizializzazione) ---
POSTGRES_DB=sitoj
POSTGRES_USER=sitoj_admin
POSTGRES_PASSWORD=change-me-admin

# --- Un utente DB per ogni microservizio ---
PROFILE_DB_USER=profile_svc
PROFILE_DB_PASSWORD=change-me-profile

PROJECTS_DB_USER=projects_svc
PROJECTS_DB_PASSWORD=change-me-projects

CONTACT_DB_USER=contact_svc
CONTACT_DB_PASSWORD=change-me-contact
