# Copia questo file in ".env" e cambia le password (.env NON va mai committato).
#   cp .env.example .env

# --- PostgreSQL (superuser, usato solo per l'inizializzazione) ---
POSTGRES_DB=sitoj
POSTGRES_USER=sitoj_admin
POSTGRES_PASSWORD=change-me-admin

# --- Un utente DB per ogni microservizio ---
PROFILE_DB_USER=profile_svc
PROFILE_DB_PASSWORD=change-me-profile

PROJECTS_DB_USER=projects_svc
PROJECTS_DB_PASSWORD=change-me-projects

CONTACT_DB_USER=contact_svc
CONTACT_DB_PASSWORD=change-me-contact

# --- contact-service ---
# Cloudflare Turnstile: in sviluppo usa la chiave di test che accetta sempre; in produzione il secret vero
# Site key pubblica (va nell'HTML del form). Test: 1x00000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Chiave HMAC per l'hash degli IP dei visitatori. OBBLIGATORIA: con il valore d'esempio il servizio non parte.
# Generala con:  openssl rand -hex 32
CONTACT_IP_SALT=change-me-salt
# Email di notifica (Gmail: usa una "password per le app", non la password dell'account)
CONTACT_NOTIFY_TO=tua-email@gmail.com
MAIL_USERNAME=tua-email@gmail.com
MAIL_PASSWORD=change-me-app-password
# La password per le app di Google si scrive SENZA spazi (Google la mostra a gruppi di 4)

# --- Sito pubblico (Caddy + web-public) ---
# In locale lascia commentato: valgono i default (http://localhost, porta 8088).
# In produzione: il tuo dominio. Caddy chiede da solo il certificato HTTPS a Let's Encrypt.
# SITE_ADDRESS=tuonome.is-a.dev
# SITE_BASE_URL=https://tuonome.is-a.dev
# Versione delle immagini da GHCR (default: latest)
# IMAGE_TAG=latest
